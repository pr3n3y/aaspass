{
  "name": "@aaspaas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src tests",
    "format": "prettier --write src tests prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "accept": "tsx scripts/accept.ts",
    "accept:rest": "tsx scripts/accept-rest.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "x-dependency-notes": {
    "fastify": "HTTP server. Its built-in logger is pino.",
    "pino": "Structured logs, used directly for the cutoff job.",
    "@fastify/cors": "Admin web app calls this API from another origin.",
    "@fastify/jwt": "Signed access tokens.",
    "zod": "Validate every request body and query.",
    "@prisma/client": "Typed PostgreSQL access.",
    "prisma": "Schema migrations and client generation.",
    "dotenv": "Load apps/api/.env in development.",
    "node-cron": "Run the deal cutoff worker every minute.",
    "tsx": "Run TypeScript for the server, seed, and tests.",
    "typescript": "Strict TypeScript.",
    "eslint": "Lint API code.",
    "@eslint/js": "ESLint base rules.",
    "typescript-eslint": "TypeScript lint rules.",
    "prettier": "Format API code."
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@prisma/client": "^6.9.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.4.0",
    "node-cron": "^4.2.0",
    "pino": "^9.7.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.0.10",
    "eslint": "^9.29.0",
    "prettier": "^3.6.2",
    "prisma": "^6.9.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
